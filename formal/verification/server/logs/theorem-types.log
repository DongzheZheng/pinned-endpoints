        (HDiv.hDiv.{0, 0, 0}
          (HMul.hMul.{0, 0, 0} (HMul.hMul.{0, 0, 0} c (HSub.hSub.{0, 0, 0} 1 c)) (HSub.hSub.{0, 0, 0} 1 B))
