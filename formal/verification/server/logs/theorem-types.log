        (HMul.hMul.{0, 0, 0} (HMul.hMul.{0, 0, 0} 2 A) B)))
    (And
      (Eq.{1}
        (HSub.hSub.{0, 0, 0}
          (HDiv.hDiv.{0, 0, 0} (HSub.hSub.{0, 0, 0} 1 (HPow.hPow.{0, 0, 0} B 2)) (HMul.hMul.{0, 0, 0} 2 A)) d)
        (HDiv.hDiv.{0, 0, 0}
          (HMul.hMul.{0, 0, 0} (HMul.hMul.{0, 0, 0} (Neg.neg.{0} c) (HSub.hSub.{0, 0, 0} 1 c))
